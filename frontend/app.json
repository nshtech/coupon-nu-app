{
  "expo": {
    "name": "Willies Wallet",
    "slug": "willieswallet",
    "owner": "studentholdings",
    "currentFullName": "@studentholdings/willieswallet",
    "originalFullName": "@studentholdings/willieswallet",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "willieswallet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf6e8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.studentholdings.willieswallet",
      "appleTeamId": "X9WWH4VD28"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.studentholdings.willieswallet",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Willie uses your location to let you know when you are near a spot with a deal.",
          "locationAlwaysAndWhenInUsePermission": "Allow location Always so Willie can give you a heads-up when you walk past a spot with a deal, even when the app is closed. Your location never leaves your phone.",
          "locationAlwaysPermission": "Allow location Always so Willie can give you a heads-up when you walk past a spot with a deal, even when the app is closed. Your location never leaves your phone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d90f712-c7aa-488a-8d08-2a08c0afeeaf"
      }
    }
  }
}
